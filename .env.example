FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///instance/blogsphere.db
# For PostgreSQL, use: postgresql+psycopg://user:password@localhost:5432/blogsphere
UPLOAD_FOLDER=app/static/uploads
# Docker Compose embeds this in a database URL; use URL-safe random hex, e.g. secrets.token_hex(32).
POSTGRES_PASSWORD=replace-with-url-safe-random-value
